<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>



<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.wgu.restrel.appointmentsapplication.Controllers.AppointmentsController"
            prefHeight="400.0" prefWidth="600.0"
            stylesheets="@app.css"
            styleClass="appointments_view"
            alignment="CENTER" spacing="40.0"
>

    <!--Appointments Form -->
    <!--Appointment_ID, Title, Description, Location, Contact, Type, Start, End, -->

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!--customer name, address, postal code, and phone number-->
    <Label fx:id="formStateLabel" text="Schedule an Appointment" styleClass="form_label" />

    <HBox alignment="CENTER" spacing="30.0" styleClass="appointment_content">

        <VBox alignment="CENTER" spacing="10.0"  styleClass="appointment_section">
            <!--customer id is disable, view only-->
            <Label text="Appointment ID:" />
            <TextField fx:id="appointmentIdField"  promptText="Auto-generated" editable="false"  styleClass="auto_form_field"/>

            <Label text="Title:" />

            <TextField fx:id="titleField" styleClass="form_field"/>

            <Label text="Description:" />

            <TextField fx:id="descriptionField" styleClass="form_field" />

            <Label text="Location:" />

            <TextField fx:id="locationField" styleClass="form_field"/>

            <Label text="Type:" />

            <TextField fx:id="typeField" styleClass="form_field"/>


        </VBox>

        <VBox alignment="CENTER" spacing="10.0"  styleClass="contact_section">
            <Label text="Contact:" />

            <ChoiceBox fx:id="contactChoiceBox" styleClass="form_field"/>

            <Label text="Date:" />

            <DatePicker fx:id="datePicker" editable="false" styleClass="form_field"/>

            <Label text="Start Time (Local):" />

            <HBox spacing="10.0">
                <ChoiceBox fx:id="startHourChoiceBox" styleClass="time_field"/>
                <Label text=" : " />
                <ChoiceBox fx:id="startMinuteChoiceBox" styleClass="time_field"/>
                <ChoiceBox fx:id="startAmPmChoiceBox" styleClass="time_field"/>
            </HBox>


            <Label text="End Time (Local):" />

            <HBox spacing="10.0">
                <ChoiceBox fx:id="endHourChoiceBox" styleClass="time_field"/>
                <Label text=" : " />
                <ChoiceBox fx:id="endMinuteChoiceBox" styleClass="time_field"/>
                <ChoiceBox fx:id="endAmPmChoiceBox" styleClass="time_field"/>
            </HBox>

        </VBox>

        <VBox alignment="CENTER" spacing="30.0"  styleClass="time_section">
            <Label fx:id="businessHoursLabel" text="Bussiness Hours: " styleClass="business_hours_label" />
        </VBox>

    </HBox>

    <HBox styleClass="form_selection_buttons" spacing="40.0" alignment="TOP_CENTER">
        <Button text="Submit" onAction="#onSubmitButtonClick" styleClass="form_button"/>
        <Button text="Cancel" onAction="#onCancelButtonClick" styleClass="form_button"/>
    </HBox>


</VBox>
